# --- Database ---
# SQLite cho phát triển: dùng file ./shop.db
# Để đổi sang MySQL chỉ cần thay đổi DATABASE_URL
DATABASE_URL=sqlite:///./shop.db

# --- CORS ---
# Origin của frontend (Vite dev server chạy port 5173)
CORS_ORIGINS=http://localhost:5173

# --- JWT ---
# Khóa bí mật để ký token - thay đổi ở production!
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Security ---
BCRYPT_ROUNDS=12

# --- App ---
APP_NAME=[TÊN SHOP]
APP_ENV=development

# --- Gemini API ---
GEMINI_API_KEY=